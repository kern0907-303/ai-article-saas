JWT_SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_SECRET=replace-with-32-byte-base64-key
ADMIN_API_KEY=replace-with-a-long-random-admin-key
AUTH_ENABLED=false
REQUIRE_PERSISTENT_DATABASE=false

# Recommended for production:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional for local SQLite storage:
# STORAGE_DIR=./storage
# CORS_ORIGINS=http://localhost:3001,https://your-frontend-domain.netlify.app

# Optional pCloud upload target for generated images:
# PCLOUD_AUTH_TOKEN=your-pcloud-auth-token
# PCLOUD_API_HOST=api.pcloud.com
# PCLOUD_FOLDER_ID=123456789
# PCLOUD_FOLDER_PATH=/AI Article Images
# PCLOUD_UPLOAD_LINK_CODE=your-upload-link-code
# PCLOUD_PUBLIC_FOLDER_PATH=/Users/erickair/pCloud Drive/Public Folder/article
# PCLOUD_PUBLIC_BASE_URL=https://your-public-folder-direct-link/article
# PCLOUD_CREATE_PUBLIC_LINK=true
# PCLOUD_USE_DIRECT_DOWNLOAD_LINK=true
